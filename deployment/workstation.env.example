# Export these in the server process; do not commit real secrets.
MAI_HOST=127.0.0.1
MAI_ASR_DEVICE=cpu
MAI_ASR_COMPUTE_TYPE=int8
MAI_ASR_MODEL=small
MAI_ALLOW_REGISTRATION=0
# MAI_ALLOWED_ORIGINS=https://meetings.example.org
# For a compatible GPU: MAI_ASR_DEVICE=cuda, MAI_ASR_COMPUTE_TYPE=float16.
# CUDA acceleration here applies to ASR; the ONNX speaker stage uses CPU.
