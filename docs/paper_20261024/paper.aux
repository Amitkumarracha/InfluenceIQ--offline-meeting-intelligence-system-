\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Feature availability on 28 GAP meetings and 84 participants. A feature is available when its normalized value is nonzero; counts and percentages use the column denominators.}}{7}{}\protected@file@percent }
\newlabel{tab:3}{{III}{7}}
\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Main matched comparison on 28 GAP meetings, 84 participants and 87 comparable pairs. Higher pairwise accuracy is better; intervals are descriptive. Exact top set is complete winner-set agreement. Nonconstant output counts meetings with distinct participant scores and measures coverage, not correctness.}}{7}{}\protected@file@percent }
\newlabel{tab:4}{{IV}{7}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces All seven matched methods on 28 GAP meetings. Points show meeting-average pairwise accuracy and bars show descriptive 95\% meeting-bootstrap intervals. The latest combined Ridge result is 68.93\%; the dashed line marks the constant-tie score. Prior corpus reuse and overlapping fitted folds limit inference.}}{8}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Contribution-feature availability among 84 participants and 28 meetings. Labels give active counts and percentages. Slide grounding is unavailable by design; the remaining inactive categories diagnose extraction or association limitations. Zero activity is not evidence of zero human contribution.}}{8}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {V}{\ignorespaces Paired differences; positive values favor the first method.}}{8}{}\protected@file@percent }
\newlabel{tab:5}{{V}{8}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Paired meeting-average differences and descriptive 95\% paired-bootstrap intervals. Positive values favor the first method. All three intervals cross zero, so these observations do not establish a reliable performance gain.}}{9}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {VI}{\ignorespaces All original GAP finalists: 16 fitting, six development and six historical evaluation meetings. PA is meeting-average pairwise accuracy; higher is better. The primary was selected on development PA, not on historical results. This earlier snapshot is distinct from Table IV.}}{9}{}\protected@file@percent }
\newlabel{tab:6}{{VI}{9}}
\@writefile{lot}{\contentsline {table}{\numberline {VII}{\ignorespaces All later GAP ranking finalists on the six historical meetings. PA is meeting-average pairwise accuracy; higher is better. B uses the earlier semantic/role snapshot and C corrected extraction/attribution. Repeated historical evaluation is exploratory, and these rows are not matched to Table IV's 28-meeting protocol.}}{10}{}\protected@file@percent }
\newlabel{tab:7}{{VII}{10}}
\@writefile{lot}{\contentsline {table}{\numberline {VIII}{\ignorespaces Ablations on the same 28 meetings. PA is meeting-average pairwise accuracy. Ridge rows refit under identical nested tuning and use the 68.93\% full reference; weight-deletion rows have no refit or renormalization and use the 55.77\% fixed reference. Negative changes reduce PA; constant meetings have tied scores for every participant.}}{11}{}\protected@file@percent }
\newlabel{tab:8}{{VIII}{11}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Ablation changes relative to each panel's full system. Left: the same nested procedure refits Ridge after removing one feature family, relative to the 68.93\% combined model. Right: single contribution weights are deleted without refitting or renormalization, relative to the 55.77\% fixed score. The two references and interventions differ.}}{11}{}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {IX}{\ignorespaces All supporting classifier finalists. AMI rows report positive-class discussion F1 and GAP rows unweighted four-role macro F1; higher is better. Historical cohorts and label targets differ from participant-ranking PA, so these scores cannot establish cross-task superiority.}}{12}{}\protected@file@percent }
\newlabel{tab:9}{{IX}{12}}
